# SAMCO IMS/QMS Demo environment
# Copy to .env.local for local development.
# Core app starts without Supabase or OpenAI. Missing optional keys degrade those features only.

# Demo presentation mode: quick-login buttons, Demo Environment badge, reset data
# Optional — defaults to true
DEMO_MODE=true

# Shared demo password for all seeded accounts (documented in docs/DEMO_ACCOUNTS.md)
# Optional — defaults to SamcoDemo@2026
DEMO_PASSWORD=SamcoDemo@2026

# Session signing secret (replace in any non-local environment)
# Optional locally — has a built-in demo default. Set a unique value on Vercel.
AUTH_SECRET=samco-demo-auth-secret-change-in-production-32b

# Optional File Intelligence hosted storage. Not required for core app startup.
# Local demo writes to data/uploads. Vercel without these keys disables upload only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=samco-documents
MAX_UPLOAD_BYTES=10485760

# Optional live AI. When empty, MockAIProvider is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public flags only — never put secrets in NEXT_PUBLIC_* except the project URL/anon key
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=SAMCO Integrated IMS/QMS Platform
